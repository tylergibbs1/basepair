{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-perf", "jsx-a11y", "nextjs", "import", "promise"],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.2.4"
    }
  },
  "rules": {
    "no-console": "off",
    "eslint/no-unused-vars": "warn",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "react-perf/jsx-no-jsx-as-prop": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**", "trigger/**", "bots/**", "drizzle/**"],
      "rules": {
        "no-await-in-loop": "off",
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [".next", "node_modules", "drizzle", "public", ".trigger", ".vite-hooks", "**/*.min.js"]
}
