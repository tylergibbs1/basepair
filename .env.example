# Copy to .env.local and fill in. All secrets stay out of git (.env* is ignored).

# --- Medplum (clinical substrate: FHIR store, auth, CDS Hooks trigger) ---
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# --- Supabase Postgres via Drizzle (app-only config) ---
# Transaction pooler for the app; session/direct connection for migrations.
DATABASE_URL=
DATABASE_URL_SESSION=

# --- Trigger.dev (durable evaluateOrder task) ---
TRIGGER_SECRET_KEY=

# --- Claude via Vercel AI Gateway ---
AI_GATEWAY_API_KEY=
# Optional model override (AI Gateway model string).
# BASEPAIR_MODEL=anthropic/claude-opus-4.5

# --- Upstash Redis (lib/cache: per-tenant rate limiting + terminology cache) ---
# OPTIONAL. When unset, the app still runs: the rate limiter is a no-op
# (allows everything) and the terminology cache falls back to an in-process
# Map. Set both for real rate limiting + shared caching. Values are on the
# database page at https://console.upstash.com/redis (REST API section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
