# Copy to .env.local and fill in. All secrets stay out of git (.env* is ignored).

# --- Medplum (clinical substrate: FHIR store, auth, CDS Hooks trigger) ---
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# --- Supabase Postgres via Drizzle (app-only config) ---
# Transaction pooler for the app; session/direct connection for migrations.
DATABASE_URL=
DATABASE_URL_SESSION=

# --- Trigger.dev (durable evaluateOrder task) ---
TRIGGER_SECRET_KEY=

# --- Claude via Vercel AI Gateway ---
AI_GATEWAY_API_KEY=
# Optional model override (AI Gateway model string).
# BASEPAIR_MODEL=anthropic/claude-opus-4.5

# --- Upstash Redis (lib/cache: per-tenant rate limiting + terminology cache) ---
# OPTIONAL. When unset, the app still runs: the rate limiter is a no-op
# (allows everything) and the terminology cache falls back to an in-process
# Map. Set both for real rate limiting + shared caching. Values are on the
# database page at https://console.upstash.com/redis (REST API section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Pinecone (lib/pinecone: two vector indexes, integrated inference) ---
# OPTIONAL. When PINECONE_API_KEY is unset both vector paths no-op: normalizeDrug
# uses RxNav + the static alias map, and the verifier grades against the catalog's
# own guidelineText. Set the key, then build the indexes:
#   bun run pinecone:drugs        (basepair-drugs   — normalizeDrug synonym fallback)
#   bun run pinecone:guidelines   (basepair-guidelines — verifier citation retrieval)
PINECONE_API_KEY=
# Optional overrides (defaults shown):
# PINECONE_DRUG_INDEX=basepair-drugs
# PINECONE_GUIDELINE_INDEX=basepair-guidelines
# Per-index embed model, matched to the data shape (see lib/pinecone/client.ts):
# drugs = a sparse/lexical model (names/brands); guidelines = a general dense model.
# PINECONE_DRUG_EMBED_MODEL=pinecone-sparse-english-v0
# PINECONE_GUIDELINE_EMBED_MODEL=llama-text-embed-v2
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# Score floors (safety): a drug match below this is rejected (raw string kept).
# PINECONE_DRUG_MIN_SCORE=0.6
# PINECONE_GUIDELINE_MIN_SCORE=0.5
