# Copy to .env.local and fill in. All secrets stay out of git (.env* is ignored).

# --- Medplum (clinical substrate: FHIR store, auth, CDS Hooks trigger) ---
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
BASEPAIR_TENANT_ID=

# AES-256-GCM key for sealed tenant credentials (`openssl rand -base64 32`).
TENANT_CREDS_KEY=

# HMAC/shared webhook secret. Production ingress fails closed when unset.
CDS_WEBHOOK_SECRET=

# --- Supabase Postgres via Drizzle (app-only config) ---
# Transaction pooler for the app; session/direct connection for migrations.
DATABASE_URL=
DATABASE_URL_SESSION=

# --- Better Auth (pharmacist console login: email + password) ---
# SECRET: min 32 chars — generate with `openssl rand -base64 32`.
# URL: the app's base URL (http://localhost:3000 in dev, https://basepairrx.com in prod).
# Accounts are seeded (scripts/seed-user.ts); public sign-up is disabled.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Trigger.dev (durable evaluateOrder task) ---
TRIGGER_SECRET_KEY=

# --- Claude via direct Anthropic provider ---
ANTHROPIC_API_KEY=
# Optional local-only model override (direct Anthropic model id).
# BASEPAIR_MODEL=claude-opus-4-8

# --- Mistral OCR (PGx report PDF extraction) ---
# OPTIONAL unless using the PDF intake/extraction path. The adapter defaults to
# Mistral's OCR alias `mistral-ocr-latest`; pin MISTRAL_OCR_MODEL only for local
# tests/reproducibility.
MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# --- Upstash Redis (lib/cache: per-tenant rate limiting + terminology cache) ---
# OPTIONAL. When unset, the app still runs: the rate limiter is a no-op
# (allows everything) and the terminology cache falls back to an in-process
# Map. Set both for real rate limiting + shared caching. Values are on the
# database page at https://console.upstash.com/redis (REST API section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Pinecone (lib/pinecone: guideline-prose retrieval for the verifier, #28) ---
# OPTIONAL. When PINECONE_API_KEY is unset the guideline retrieval no-ops and the
# verifier grades against the catalog's own guidelineText. Set the key, then:
#   bun run pinecone:guidelines   (basepair-guidelines — verifier citation retrieval)
PINECONE_API_KEY=
# Optional overrides (defaults shown):
# PINECONE_GUIDELINE_INDEX=basepair-guidelines
# PINECONE_GUIDELINE_EMBED_MODEL=llama-text-embed-v2
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# PINECONE_GUIDELINE_MIN_SCORE=0.5
